# /etc/p2paecn-board/board.env, read by deploy/p2paecn-board.service. Mode 0640, owner root, group p2paecn.
# Placeholders only. Holds no secret: the board has no token or password; the operator socket's file mode is the
# control, and the state file holds only public keys and hashes of enrollment codes (but every card in plain text).

# The host string every request is signed for. Exactly the authority of the URL members are given, in lower case:
# for https://board.example it is board.example (no port, because 443 is the default). Anything else and every
# request gets the 401.
P2PAECN_HOST=board.example

# The public listener. Loopback only: the TLS proxy on the same machine is the only way in.
P2PAECN_BIND=127.0.0.1:8787

# The operator channel. Relative to WorkingDirectory (/var/lib/p2paecn-board, mode 0700), so the path stays short.
P2PAECN_ADMIN_SOCKET=op.sock

# The state file. Every accepted change is saved here before it is answered. Unset: memory only, and a restart
# forgets every organisation, room, key and card.
P2PAECN_STATE=/var/lib/p2paecn-board/state.json

# P2PAECN_CONFIG is for tests and local trials. Leave it unset on the host. If it is set, it is applied only when
# the state file does not exist yet.
